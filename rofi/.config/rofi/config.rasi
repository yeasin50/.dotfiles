configuration {
    modi: "drun";
    show-icons: true;
    display-drun: "";
    drun-display-format: "{name}";
    font: "JetBrains Mono Nerd Font 11";
}

@import "theme.rasi"

window {
    width: 35%;
    padding: 15px;
}

mainbox {
    spacing: 15px;
}

inputbar {
    children: [prompt, entry];
    padding: 10px;
}

prompt {
    padding: 6px 12px;
    margin: 0px 10px 0px 0px;
    font: "JetBrains Mono Nerd Font Bold 11";
}

entry {
    padding: 6px 0px;
    placeholder: "Search applications...";
}

listview {
    columns: 1;
    lines: 7;
    spacing: 6px;
    cycle: false;
    dynamic: true;
    scrollbar: false;
}

element {
    padding: 10px 12px;
    border-radius: 8px;
    spacing: 12px;
    orientation: horizontal;
}

element-icon {
    size: 24px;
}

element-text {
    vertical-align: 0.5;
}

textbox {
    padding: 16px;
    font: "JetBrains Mono Nerd Font 16";
    horizontal-align: 0.5;
    vertical-align: 0.5;
}
