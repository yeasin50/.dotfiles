super + shift + v
    bspc node @/ -R 90

# --- Focus movement  ---
super + {Left,Down,Up,Right}
    bspc node -f {west,south,north,east}

# --- Move window (like sway move container) ---
super + shift + {Left,Right,Up,Down}
    bspc node -s {west,east,north,south}

# toggle between floating and tiling
super + shift + space
    bspc node -t ~floating

# workspace navigation
super + {1-6}
    bspc desktop -f {1-6}

# move window between workspace
super + shift + {1-6}
    bspc node -d {1-6}



# game specifics 
#
Page_Up 
    ~/.config/sxhkd/click_loop 8

Page_Down
    ~/.config/sxhkd/click_loop
